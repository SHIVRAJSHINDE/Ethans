      <column caption='Hight_Low' datatype='string' name='[Calculation_1682938912028229635]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &lt;100 &#13;&#10;THEN &quot;lOW&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
