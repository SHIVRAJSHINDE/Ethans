      <column caption='IF_High_AVG_LOW' datatype='string' name='[Calculation_1682938912029437956]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales])&lt;=55&#13;&#10;THEN &quot;LOW&quot;&#13;&#10;ELSEIF SUM([Sales])&lt;=320&#13;&#10;THEN &quot;AVG&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
