      <aliases enabled='yes' />
      <column caption='Applicant Income' datatype='integer' name='[ApplicantIncome]' role='measure' type='quantitative' />
      <column caption='Age_Backet' datatype='string' name='[Calculation_1451285010384121856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Age]&lt;=35&#13;&#10;THEN &quot;Young&quot;&#13;&#10;ELSEIF [Age]&lt;= 45&#13;&#10;THEN &quot;Mid Age&quot;&#13;&#10;ELSEIF  [Age]&lt;= 55&#13;&#10;THEN &quot;Sr. Citizen&quot;&#13;&#10;ELSE &quot;Old&quot;&#13;&#10;END' />
      </column>
